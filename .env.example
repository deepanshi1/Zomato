# Copy to .env and fill in. Never commit .env.

# OpenAI-compatible chat completion endpoint, e.g. https://api.openai.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional: seconds before a model call times out (default 30)
# LLM_TIMEOUT_SECONDS=30

# Local catalog written by the ingestion job
CATALOG_PATH=data/catalog.parquet

# Max restaurants sent to the model
CANDIDATE_POOL=20

# Recommendations returned when the request omits limit (max 8)
DEFAULT_LIMIT=5
