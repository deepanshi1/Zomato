# Copy to .env and fill in. Never commit .env, and never put a real key in this file.

# Groq, OpenAI-compatible chat completion endpoint (the client appends /chat/completions)
LLM_BASE_URL=https://api.groq.com/openai/v1
# Groq API key from https://console.groq.com/keys
LLM_API_KEY=
# Default model; supports strict JSON Schema output. Faster fallback: openai/gpt-oss-20b
# Check what your key can use: GET https://api.groq.com/openai/v1/models
LLM_MODEL=openai/gpt-oss-120b
# json_schema (strict, default), json_object (models without strict schema support), or off
LLM_RESPONSE_FORMAT=json_schema
# Optional: seconds before a model call times out (default 30)
# LLM_TIMEOUT_SECONDS=30

# Local catalog written by the ingestion job
CATALOG_PATH=data/catalog.parquet

# Max restaurants sent to the model
CANDIDATE_POOL=20

# Recommendations returned when the request omits limit (max 8)
DEFAULT_LIMIT=5
